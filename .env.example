# Este arquivo serve como um exemplo das variáveis de ambiente necessárias para o projeto.
# Em um ambiente de CI/CD como o GitHub Actions, estas variáveis devem ser configuradas como "Secrets" no repositório.

# Credenciais do Docker Hub para publicar a imagem
DOCKER_USERNAME=seu_usuario_docker
DOCKER_PASSWORD=sua_senha_ou_token_docker

# Credenciais da AWS para o pipeline fazer o deploy
AWS_ACCESS_KEY_ID=sua_chave_de_acesso_aws
AWS_SECRET_ACCESS_KEY=sua_chave_secreta_aws

# Informações da instância EC2 para acesso via SSH
EC2_HOST=ip_publico_da_sua_instancia_ec2
EC2_USER=ec2-user
EC2_KEY=conteudo_da_sua_chave_privada_pem